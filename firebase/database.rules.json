{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        "totalMoney": {
          ".read": "auth != null"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            /* Joining (creating a player node) only happens through the joinGame
               Cloud Function, which writes via the Admin SDK and so bypasses these
               rules entirely. The one thing a client may do directly is delete its
               own node — covering both an explicit "leave" and onDisconnect(). */
            ".write": "auth != null && auth.uid === $uid && !newData.exists()"
          }
        }
      }
    }
  }
}
